  {"n": 1, "title": "Умра деген не және оның қажылықтан айырмашылығы", "status": "preparing"},
  {"n": 2, "title": "Ниет және ықылас", "status": "preparing"},
  {"n": 3, "title": "Жолға шығар алдында: тәубе, қарыз, кешірім", "status": "preparing"},
