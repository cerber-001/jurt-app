  {"n": 5, "title": "Жол әдебі: сабыр, сөз, серіктер", "status": "preparing"},
  {"n": 6, "title": "Ханафи мәзһабы бойынша дәрет: парыздары мен сүннеттері", "status": "preparing"},
  {"n": 7, "title": "Дәретті не бұзады", "status": "preparing"},
  {"n": 8, "title": "Ғұсыл — толық жуыну", "status": "preparing"},
